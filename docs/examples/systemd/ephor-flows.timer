# ~/.config/systemd/user/ephor-flows.timer
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now ephor-flows.timer
#
# Set [flows] tmux_session in board.toml: a tick started by systemd has no
# tmux client of its own to open windows next to.
[Unit]
Description=Run ephor flows tick every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
